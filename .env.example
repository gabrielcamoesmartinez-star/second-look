# Copy to .env at the repo root for local development. Never commit .env.
# Where each value is set in production is noted on the right.

# --- Supabase (Settings → API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co          # web (Vercel), worker (Fly)
SUPABASE_ANON_KEY=                                      # web (Vercel). Public by design; RLS protects data.
SUPABASE_SERVICE_ROLE_KEY=                              # worker (Fly) ONLY. Never in Vercel, never in the browser.
#   Edge Functions get SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY injected by Supabase automatically.

# --- Public site ---
PUBLIC_SITE_URL=http://localhost:5173                   # worker (bot user agent) + Edge Function secrets (CORS origin)

# --- Google PageSpeed Insights (console.cloud.google.com → APIs → PageSpeed Insights API → Credentials) ---
PAGESPEED_API_KEY=                                      # worker (Fly)

# --- Anthropic (Stage 2) ---
ANTHROPIC_API_KEY=                                      # worker (Fly) ONLY
CLAUDE_MODEL=claude-haiku-5-5                          # worker. A current Claude model id; never hard-coded in code.
AI_INPUT_USD_PER_MTOK=0.1                               # worker. Price per million input tokens for CLAUDE_MODEL (for cost tracking)
AI_OUTPUT_USD_PER_MTOK=0.5                              # worker. Price per million output tokens

# --- Cost and abuse limits ---
DAILY_AI_BUDGET_USD=0.50                                # worker. When today's AI spend reaches this, AI checks pause (rules still run)
AUDITS_PER_USER_PER_DAY=3                               # Edge Function secret AND web (Vercel) — keep them equal
AUDITS_PER_IP_PER_DAY=10                                # Edge Function secret
IP_HASH_SALT=                                           # Edge Function secret. Long random string: openssl rand -hex 32

# --- Worker ---
WORKER_CONCURRENCY=2                                    # max 2
CHROMIUM_PATH=                                          # optional; leave empty in Docker (the Playwright image ships Chromium)

# --- Observability (optional) ---
SENTRY_DSN=
