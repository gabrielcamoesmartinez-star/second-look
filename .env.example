# Copy to .env (worker) — never commit real values.
# Worker / Edge Functions only (server side):
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
PAGESPEED_API_KEY=
WORKER_ID=local-worker
WORKER_CONCURRENCY=2
POLL_INTERVAL_MS=2000
BOT_INFO_URL=https://your-domain.example/bot
# Optional: use a system Chrome instead of Playwright's Chromium
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Edge Function secrets (set with: supabase secrets set KEY=value)
AUDITS_PER_USER_PER_DAY=3
AUDITS_PER_IP_PER_DAY=10
IP_HASH_SALT=
ALLOWED_ORIGINS=http://localhost:5173

# Stage 2 (not used yet)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
DAILY_AI_BUDGET_USD=5
